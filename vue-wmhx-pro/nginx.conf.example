# Nginx配置示例 - Linux部署环境
server {
    listen 80;
    server_name your_domain.com;  # 替换为您的域名

    # 设置根目录为Vue项目的dist目录
    root /home/www/FlaskAndVuePro/dist;
    index index.html;

    # 处理Vue路由 - 支持单页应用
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 配置文件路由 - 允许直接访问config目录下的配置文件
    location /config/ {
        alias /home/www/FlaskAndVuePro/dist/config/;
        add_header Access-Control-Allow-Origin *;  # 允许跨域访问配置文件
        add_header Cache-Control "no-cache, no-store, must-revalidate";  # 禁止缓存配置文件
        add_header Pragma "no-cache";
        add_header Expires 0;
    }

    # API请求代理到Flask服务
    location /api/ {
        proxy_pass http://localhost:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 静态资源缓存设置
    location ~* \.(jpg|jpeg|png|gif|ico|css|js)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    # 错误页面
    error_page 404 /index.html;

    # 日志设置
    access_log /var/log/nginx/your_app_access.log;
    error_log /var/log/nginx/your_app_error.log;
}