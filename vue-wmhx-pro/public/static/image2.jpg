<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <rect width="800" height="500" fill="#f0f9ff"/>
  <rect width="800" height="100" fill="#10b981"/>
  <text x="400" y="60" font-family="Arial" font-size="36" font-weight="bold" text-anchor="middle" fill="white">科技新闻</text>
  <rect x="50" y="150" width="700" height="300" fill="white" stroke="#6ee7b7" stroke-width="2" rx="10"/>
  <text x="400" y="220" font-family="Arial" font-size="28" font-weight="bold" text-anchor="middle" fill="#065f46">量子计算实现重大突破</text>
  <text x="400" y="270" font-family="Arial" font-size="20" text-anchor="middle" fill="#334155">科学家成功研发出100量子比特处理器，计算能力提升百万倍</text>
  <text x="400" y="320" font-family="Arial" font-size="18" text-anchor="middle" fill="#64748b">该技术有望在密码学、材料科学和药物研发等领域带来革命性变化</text>
  <text x="400" y="370" font-family="Arial" font-size="16" text-anchor="middle" fill="#94a3b8">发布日期: 2023-12-02</text>
  <circle cx="150" cy="420" r="40" fill="#a7f3d0"/>
  <text x="150" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#065f46">量子</text>
  <circle cx="350" cy="420" r="40" fill="#a7f3d0"/>
  <text x="350" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#065f46">计算</text>
  <circle cx="550" cy="420" r="40" fill="#a7f3d0"/>
  <text x="550" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#065f46">突破</text>
  <circle cx="750" cy="420" r="40" fill="#a7f3d0"/>
  <text x="750" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#065f46">未来</text>
</svg>