<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <rect width="800" height="500" fill="#f0f9ff"/>
  <rect width="800" height="100" fill="#3b82f6"/>
  <text x="400" y="60" font-family="Arial" font-size="36" font-weight="bold" text-anchor="middle" fill="white">科技新闻</text>
  <rect x="50" y="150" width="700" height="300" fill="white" stroke="#93c5fd" stroke-width="2" rx="10"/>
  <text x="400" y="220" font-family="Arial" font-size="28" font-weight="bold" text-anchor="middle" fill="#1e40af">AI大模型取得突破性进展</text>
  <text x="400" y="270" font-family="Arial" font-size="20" text-anchor="middle" fill="#334155">最新研究显示，新一代AI大模型在复杂推理任务上超越人类专家水平</text>
  <text x="400" y="320" font-family="Arial" font-size="18" text-anchor="middle" fill="#64748b">研究人员表示，该模型在医疗诊断、科学发现等领域具有广阔应用前景</text>
  <text x="400" y="370" font-family="Arial" font-size="16" text-anchor="middle" fill="#94a3b8">发布日期: 2023-11-15</text>
  <circle cx="150" cy="420" r="40" fill="#bfdbfe"/>
  <text x="150" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#1e40af">AI</text>
  <circle cx="350" cy="420" r="40" fill="#bfdbfe"/>
  <text x="350" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#1e40af">科技</text>
  <circle cx="550" cy="420" r="40" fill="#bfdbfe"/>
  <text x="550" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#1e40af">创新</text>
  <circle cx="750" cy="420" r="40" fill="#bfdbfe"/>
  <text x="750" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#1e40af">未来</text>
</svg>