<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <rect width="800" height="500" fill="#f0f9ff"/>
  <rect width="800" height="100" fill="#8b5cf6"/>
  <text x="400" y="60" font-family="Arial" font-size="36" font-weight="bold" text-anchor="middle" fill="white">科技新闻</text>
  <rect x="50" y="150" width="700" height="300" fill="white" stroke="#c4b5fd" stroke-width="2" rx="10"/>
  <text x="400" y="220" font-family="Arial" font-size="28" font-weight="bold" text-anchor="middle" fill="#4c1d95">太空探索新发现</text>
  <text x="400" y="270" font-family="Arial" font-size="20" text-anchor="middle" fill="#334155">天文学家发现类似地球的系外行星，可能存在液态水</text>
  <text x="400" y="320" font-family="Arial" font-size="18" text-anchor="middle" fill="#64748b">这颗行星位于宜居带内，距离地球约100光年，是目前发现的最可能存在生命的系外行星之一</text>
  <text x="400" y="370" font-family="Arial" font-size="16" text-anchor="middle" fill="#94a3b8">发布日期: 2023-12-10</text>
  <circle cx="150" cy="420" r="40" fill="#ddd6fe"/>
  <text x="150" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#4c1d95">太空</text>
  <circle cx="350" cy="420" r="40" fill="#ddd6fe"/>
  <text x="350" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#4c1d95">探索</text>
  <circle cx="550" cy="420" r="40" fill="#ddd6fe"/>
  <text x="550" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#4c1d95">发现</text>
  <circle cx="750" cy="420" r="40" fill="#ddd6fe"/>
  <text x="750" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#4c1d95">宇宙</text>
</svg>