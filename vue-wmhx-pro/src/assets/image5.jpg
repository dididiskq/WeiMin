<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <rect width="800" height="500" fill="#f0f9ff"/>
  <rect width="800" height="100" fill="#06b6d4"/>
  <text x="400" y="60" font-family="Arial" font-size="36" font-weight="bold" text-anchor="middle" fill="white">科技新闻</text>
  <rect x="50" y="150" width="700" height="300" fill="white" stroke="#67e8f9" stroke-width="2" rx="10"/>
  <text x="400" y="220" font-family="Arial" font-size="28" font-weight="bold" text-anchor="middle" fill="#0e7490">元宇宙技术新进展</text>
  <text x="400" y="270" font-family="Arial" font-size="20" text-anchor="middle" fill="#334155">新一代VR设备实现全沉浸式体验，分辨率提升至16K</text>
  <text x="400" y="320" font-family="Arial" font-size="18" text-anchor="middle" fill="#64748b">这款设备采用全新传感器技术，能捕捉细微表情和身体动作，为元宇宙交互带来革命性变化</text>
  <text x="400" y="370" font-family="Arial" font-size="16" text-anchor="middle" fill="#94a3b8">发布日期: 2023-12-25</text>
  <circle cx="150" cy="420" r="40" fill="#a5f3fc"/>
  <text x="150" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#0e7490">元宇宙</text>
  <circle cx="350" cy="420" r="40" fill="#a5f3fc"/>
  <text x="350" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#0e7490">VR</text>
  <circle cx="550" cy="420" r="40" fill="#a5f3fc"/>
  <text x="550" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#0e7490">沉浸</text>
  <circle cx="750" cy="420" r="40" fill="#a5f3fc"/>
  <text x="750" y="425" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" fill="#0e7490">未来</text>
</svg>